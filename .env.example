# =================================================================
# Dual-Role AI Job Search Automation Agent - Environment Configuration
# =================================================================

# Server & Cloud Environment
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Security & Dashboard Access Control
# Set a strong password to protect your candidate profiles, resumes, and actions when public
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ChangeMeWithSecurePassword123!

# Allowed CORS Origins (comma-separated, without trailing slashes)
# In production on Render/Railway, set to your public domain (e.g., https://your-service.onrender.com)
CORS_ORIGINS=*

# Persistent Storage & Database
# Option A (Render/Railway Managed PostgreSQL):
# DATABASE_URL=postgresql://user:password@host.cloud.internal:5432/job_agent_db
# Option B (Persistent Disk with SQLite):
DATA_DIR=/app/data

# Automated Cloud Job Search Scheduler
# Set to 'true' to run automated dual-role job searches in the cloud without your computer
SCHEDULE_ENABLED=true
SCHEDULE_INTERVAL_HOURS=12

# Optional AI API Keys (if using direct Gemini/OpenAI synthesis in future expansions)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
